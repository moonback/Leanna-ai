# Copier en .env (jamais commité). Tous les secrets restent côté serveur.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# 5173 = vite dev, 4173 = vite preview (utilisé par les tests E2E).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Valeurs locales : `supabase status -o env` (API_URL et PUBLISHABLE_KEY).
SUPABASE_URL=http://127.0.0.1:59321
SUPABASE_PUBLISHABLE_KEY=

# --- Assistant IA. Chaque fournisseur s'active avec sa clé ; l'utilisateur choisit
# fournisseur + modèle dans Paramètres. Sans aucune clé : « non configuré » (503).
# Une variable déjà définie dans l'environnement système est aussi prise en compte.

# Google Gemini — https://aistudio.google.com/apikey. Une clé du niveau gratuit autorise
# Google à utiliser les contenus pour améliorer ses produits : activez la facturation.
GEMINI_API_KEY=
# Liste blanche (seuls choix possibles pour l'utilisateur) et modèle par défaut.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# OpenRouter — https://openrouter.ai/keys (crédits prépayés ; 402 si épuisés).
OPENROUTER_API_KEY=
# Identifiants exacts du catalogue https://openrouter.ai/models (forme « fournisseur/modèle »).
OPENROUTER_MODELS=anthropic/claude-haiku-5.5,mistralai/mistral-small-2603,openai/gpt-5-mini,deepseek/deepseek-v3.2
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5

# Fournisseur utilisé quand l'utilisateur n'a rien choisi (gemini | openrouter).
AI_DEFAULT_PROVIDER=gemini
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048
# Plafond par utilisateur sur 24 h glissantes (entrée + sortie + réflexion).
AI_DAILY_TOKEN_LIMIT=200000

# --- Mémoire. Les embeddings rendent le rappel sémantique ; sans eux, il reste lexical
# (recherche plein texte). auto = Gemini si sa clé existe, sinon OpenRouter, sinon aucun.
EMBEDDINGS_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Distance cosinus maximale d'un souvenir « lié » (non calibrée sur un vrai modèle).
MEMORY_MAX_DISTANCE=0.5
MEMORY_RECALL_COUNT=8

# --- Missions (Phase 5). Redis porte la file BullMQ ; la base reste la source de vérité.
# Local : docker run -d --name leana-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379
# Worker uniquement : rôle Postgres membre de `leana_worker` (jamais service_role).
# Local : postgres (qui passe en leana_worker à la connexion). Voir README → Missions.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:59322/postgres
MISSIONS_QUEUE=missions
WORKER_CONCURRENCY=4
MISSION_STEP_LEASE_MS=180000
MISSION_MAX_ATTEMPTS=3
MISSION_SWEEP_MS=30000
