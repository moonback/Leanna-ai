# Copier en .env (jamais commité). Tous les secrets restent côté serveur.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# 5173 = vite dev, 4173 = vite preview (utilisé par les tests E2E).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Valeurs locales : `supabase status -o env` (API_URL et PUBLISHABLE_KEY).
SUPABASE_URL=http://127.0.0.1:59321
SUPABASE_PUBLISHABLE_KEY=

# --- Assistant IA (Google Gemini). Sans clé, l'assistant répond « non configuré » (503).
# Clé : https://aistudio.google.com/apikey — une clé du niveau gratuit autorise Google à
# utiliser les contenus pour améliorer ses produits : activez la facturation pour de vrais usagers.
# Une variable GEMINI_API_KEY déjà définie dans l'environnement système est aussi prise en compte.
GEMINI_API_KEY=
# Liste blanche (les utilisateurs ne peuvent choisir que parmi ces modèles) et modèle par défaut.
AI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
AI_DEFAULT_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048
# Plafond par utilisateur sur 24 h glissantes (entrée + sortie + réflexion).
AI_DAILY_TOKEN_LIMIT=200000
